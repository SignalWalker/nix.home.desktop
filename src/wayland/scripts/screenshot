#! /usr/bin/env nu

def main [
    target: string
] {
    let pictures_dir = $env.XDG_PICTURES_DIR? | default $'($env.HOME)/pictures'
    let screenshots_dir = $'($pictures_dir)/screenshots'
    let date_time = ^date -Ins
    let output_file = $'($screenshots_dir)/($date_time).png'

    match $target {
        "active" => {
            hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | grim -g - $output_file
        },
        "area" => {
            slurp | grim -g - $output_file
        },
        "screen" => {
            grim $output_file
        },
        "output" => {
            let active_monitor = (hyprctl -j activewindow | jq -r '"\(.monitor)"' | into int) - 1
            let active_output = hyprctl -j monitors | jq -r ('"\(.[' ++ ($active_monitor | into string) ++ '].name)"')
            grim -o $active_output $output_file
        },
        _ => {
            error make "target must be either active, area, or screen"
        },
    }

    open $output_file | wl-copy --trim-newline
    notify-send --app-name=Screenshot --urgency=low --hint=STRING:image-path:$output_file Screenshot $output_file
    $output_file
}
